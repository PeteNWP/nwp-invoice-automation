@page
@using System.Globalization
@model Nwp.InvoiceAutomation.Web.Pages.Documents.DetailModel

@if (Model.Document is null)
{
    <div class="card empty-state">
        <h1>Document not found</h1>
        <p><a asp-page="/Inbox/Index">Back to inbox</a></p>
    </div>
}
else
{
    var d = Model.Document;
    <div class="page-heading">
        <div>
            <p class="eyebrow">Document</p>
            <h1>@(d.InvoiceNumber ?? d.Subject)</h1>
            <p class="muted">@d.Subject</p>
        </div>
        <a class="primary-link-button" asp-page="/Exceptions/Resolve" asp-route-id="@d.Id">Review / classify</a>
    </div>

    <div class="order-workspace document-detail-workspace">
        <div class="order-main">
            <div class="card">
                <h2>Captured detail</h2>
                <dl class="detail-grid">
                    <dt>Document type</dt><dd>@d.DocumentType</dd>
                    <dt>Status</dt><dd>@d.Status @(string.IsNullOrEmpty(d.ExceptionReason) ? "" : $"— {d.ExceptionReason}")</dd>
                    <dt>Detected supplier</dt><dd>@(d.DetectedSupplier ?? "—")</dd>
                    <dt>Supplier (master)</dt><dd>@(d.SupplierMasterName ?? "—")</dd>
                    <dt>Invoice number</dt><dd>@(d.InvoiceNumber ?? "—")</dd>
                    <dt>Invoice date</dt><dd>@(d.InvoiceDate?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "—")</dd>
                    <dt>Batch / reference</dt><dd>@(d.BatchOrReference ?? "—")</dd>
                    <dt>Total</dt><dd>@(d.Total is { } t ? $"{d.Currency} {t.ToString("N2", CultureInfo.InvariantCulture)}" : "—")</dd>
                    <dt>Assigned queue</dt><dd>@(d.AssignedQueue ?? "—")</dd>
                    <dt>Workflow owner</dt><dd>@(d.WorkflowOwner ?? "Maeve — standard queue")</dd>
                </dl>
            </div>

            @if (d.Extraction is { } extraction)
            {
                <div class="card">
                    <h2>Extracted invoice</h2>
                    <dl class="detail-grid">
                        <dt>Supplier</dt><dd>@(extraction.SupplierName ?? "—")</dd>
                        <dt>Invoice number</dt><dd>@(extraction.InvoiceNumber ?? "—")</dd>
                        <dt>Invoice date</dt><dd>@(extraction.InvoiceDate?.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) ?? "—")</dd>
                        <dt>Reference</dt><dd>@(extraction.Reference ?? "—")</dd>
                        <dt>Total</dt><dd>@(extraction.Total is { } et ? $"{extraction.Currency} {et.ToString("N2", CultureInfo.InvariantCulture)}" : "—")</dd>
                        <dt>Confidence</dt><dd>@(extraction.Confidence is { } confidence ? confidence.ToString("P1", CultureInfo.InvariantCulture) : "—")</dd>
                        <dt>Extracted</dt><dd>@extraction.ExtractedAt.ToUniversalTime().ToString("dd MMM yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)</dd>
                    </dl>
                    @if (extraction.Lines.Count > 0)
                    {
                        <div style="overflow-x:auto">
                            <table>
                                <thead><tr><th>Line</th><th>SKU</th><th>Description</th><th>Quantity</th><th>Unit price</th><th>Line total</th></tr></thead>
                                <tbody>
                                @foreach (var line in extraction.Lines)
                                {
                                    <tr>
                                        <td>@line.LineNumber</td><td>@(line.Sku ?? "—")</td><td>@line.Description</td>
                                        <td>@(line.Quantity?.ToString("N4", CultureInfo.InvariantCulture) ?? "—")</td>
                                        <td>@(line.UnitPrice?.ToString("N4", CultureInfo.InvariantCulture) ?? "—")</td>
                                        <td>@(line.LineTotal?.ToString("N4", CultureInfo.InvariantCulture) ?? "—")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }

            <div class="card">
                <h2>Email envelope</h2>
                <dl class="detail-grid">
                    <dt>Original mailbox</dt><dd>@d.OriginalMailbox</dd>
                    <dt>From</dt><dd>@(string.IsNullOrWhiteSpace(d.FromAddress) ? "—" : string.IsNullOrWhiteSpace(d.FromName) ? d.FromAddress : $"{d.FromName} <{d.FromAddress}>")</dd>
                    <dt>To</dt><dd>@(d.ToAddresses ?? "—")</dd>
                    <dt>Cc</dt><dd>@(d.CcAddresses ?? "—")</dd>
                    <dt>Forwarded by</dt><dd>@(d.ForwardedBy ?? "—")</dd>
                    <dt>Received</dt>
                    <dd>
                        @(d.ReceivedAt?.ToUniversalTime().ToString("dd MMM yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture) ?? d.ReceivedDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture))
                        @if (d.LateReceivedFlag) { <span class="status-flag flag-late">Late</span> }
                    </dd>
                    <dt>Message ID</dt><dd>@(d.InternetMessageId ?? d.MessageId ?? "—")</dd>
                    <dt>Conversation ID</dt><dd>@(d.ConversationId ?? "—")</dd>
                    <dt>Attachment</dt><dd>@d.AttachmentName</dd>
                    <dt>MIME type</dt><dd>@d.AttachmentMime</dd>
                    <dt>Nested email</dt><dd>@(d.IsNestedEmail ? "Yes — PDF nested inside an .eml" : "No")</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(d.EmailBodyPreview))
                {
                    <h3>Email body preview</h3>
                    <p style="white-space:pre-wrap">@d.EmailBodyPreview</p>
                }
                @if (!string.IsNullOrEmpty(d.ReviewerNote))
                {
                    <div class="alert alert-warning"><strong>Reviewer note:</strong> @d.ReviewerNote</div>
                }
            </div>
        </div>

        <aside class="box-preview document-preview-card card">
            <div class="document-preview-heading">
                <h2>Document preview</h2>
                @if (!string.IsNullOrWhiteSpace(d.GraphItemId) || !string.IsNullOrWhiteSpace(d.AttachmentPreviewUrl))
                {
                    <button type="button" class="preview-expand-button" onclick="document.getElementById('document-preview-dialog').showModal()">Expand preview</button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(d.GraphItemId) || !string.IsNullOrWhiteSpace(d.AttachmentPreviewUrl))
            {
                var previewUrl = Url.Page("/Documents/Preview", new { id = d.Id });
                var readablePreviewUrl = $"{previewUrl}#view=FitH";
                <iframe class="document-preview-frame" src="@readablePreviewUrl" title="@d.AttachmentName"></iframe>
                <p class="preview-hint muted">Use “Expand preview” for a full-screen reading view.</p>

                <dialog id="document-preview-dialog" class="document-preview-dialog">
                    <div class="document-preview-dialog-shell">
                        <div class="document-preview-dialog-heading">
                            <div>
                                <strong>@d.AttachmentName</strong>
                                <span class="muted">Document preview</span>
                            </div>
                            <button type="button" class="preview-close-button" onclick="document.getElementById('document-preview-dialog').close()" aria-label="Close full-screen preview">Close</button>
                        </div>
                        <iframe src="@readablePreviewUrl" title="Expanded preview of @d.AttachmentName"></iframe>
                    </div>
                </dialog>
            }
            else
            {
                <div class="empty-state">
                    <p class="muted">Preview is not available for @d.AttachmentName.</p>
                </div>
            }
        </aside>
    </div>

    <p><a asp-page="/Inbox/Index">← Back to inbox</a></p>

    <script>
        document.getElementById('document-preview-dialog')?.addEventListener('click', function (event) {
            if (event.target === this) this.close();
        });
    </script>
}

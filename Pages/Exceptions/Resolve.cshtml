@page "{id:guid}"
@using System.Globalization
@model Nwp.InvoiceAutomation.Web.Pages.Exceptions.ResolveModel

@if (Model.Document is null)
{
    <div class="card empty-state">
        <h1>Exception not found</h1>
        <p><a asp-page="/Exceptions/Index">Back to exceptions</a></p>
    </div>
}
else
{
    var d = Model.Document;
    var isException = d.Status == ClassificationStatus.Exception;

    <div class="page-heading">
        <div>
            <p class="eyebrow">@(isException ? "Resolve exception" : "Review document")</p>
            <h1>@(d.InvoiceNumber ?? d.Subject)</h1>
            <p class="muted">Check the classification and captured fields, correct them where needed, then choose what the system should remember.</p>
        </div>
        <div class="approval-summary">
            <strong>@(d.Status == ClassificationStatus.Exception ? "!" : "✓")</strong>
            <span>@d.Status</span>
        </div>
    </div>

    @if (Model.Saved)
    {
        <div class="alert alert-success">
            <strong>Saved.</strong> The document has been classified and moved to the selected queue. The approved supplier identity and checked teaching rules have been saved.
        </div>
    }

    @if (!string.IsNullOrEmpty(d.ExceptionReason))
    {
        <div class="alert alert-error"><strong>Why it stopped:</strong> @d.ExceptionReason</div>
    }

    <div class="exception-resolution-workspace">
        <section class="card document-preview-panel">
            <h2>Original document</h2>
            <dl class="detail-grid compact-detail-grid">
                <dt>Subject</dt><dd>@d.Subject</dd>
                <dt>Mailbox</dt><dd>@d.OriginalMailbox</dd>
                <dt>Forwarded by</dt><dd>@(d.ForwardedBy ?? "—")</dd>
                <dt>Received</dt><dd>@d.ReceivedDate.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</dd>
                <dt>Attachment</dt><dd>@d.AttachmentName</dd>
                <dt>MIME</dt><dd>@d.AttachmentMime</dd>
                <dt>Nested email</dt><dd>@(d.IsNestedEmail ? "Yes" : "No")</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(d.GraphItemId) || !string.IsNullOrWhiteSpace(d.AttachmentPreviewUrl))
            {
                var previewUrl = Url.Page("/Documents/Preview", new { id = d.Id });
                <div class="pdf-preview-frame">
                    <div class="document-preview-heading">
                        <strong>PDF preview</strong>
                        <button type="button" class="preview-expand-button" onclick="document.getElementById('exception-preview-dialog').showModal()">Expand preview</button>
                    </div>
                    <iframe src="@previewUrl" title="Preview of @d.AttachmentName"></iframe>
                </div>

                <dialog id="exception-preview-dialog" class="document-preview-dialog">
                    <div class="document-preview-dialog-shell">
                        <div class="document-preview-dialog-heading">
                            <div>
                                <strong>@d.AttachmentName</strong>
                                <span class="muted">Review document</span>
                            </div>
                            <button type="button" class="preview-close-button" onclick="document.getElementById('exception-preview-dialog').close()" aria-label="Close full-screen preview">Close</button>
                        </div>
                        <iframe src="@previewUrl" title="Expanded preview of @d.AttachmentName"></iframe>
                    </div>
                </dialog>
            }
            else
            {
                <div class="invoice-preview-placeholder">
                    <strong>Invoice/PDF/email preview</strong>
                    <span>@d.AttachmentName</span>
                    <p>The real PDF/email viewer will sit here when mailbox capture and document storage are wired in.</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(d.ReviewerNote))
            {
                <div class="alert alert-warning"><strong>Reviewer note:</strong> @d.ReviewerNote</div>
            }
        </section>

        <section class="card correction-panel">
            <h2>Correct captured fields</h2>
            <form method="post" class="exception-resolution-form">
                <div asp-validation-summary="All" class="alert alert-error"></div>
                <input asp-for="Input.ExtractionRevision" type="hidden" />

                <div class="supplier-master-field">
                    <label for="Input_SupplierSearchLabel">Supplier master</label>
                    <div class="supplier-master-picker">
                        <input asp-for="Input.SupplierSearchLabel" autocomplete="off" placeholder="Search by reference or name" aria-autocomplete="list" aria-controls="supplier-master-results" />
                        <input asp-for="Input.NwpSupplierOid" type="hidden" />
                        <div id="supplier-master-results" class="supplier-master-results" role="listbox" hidden>
                            @foreach (var supplier in Model.Suppliers)
                            {
                                <div class="supplier-master-option" role="option" tabindex="0" data-value="@supplier.DisplayLabel" data-oid="@supplier.Oid">@supplier.DisplayLabel</div>
                            }
                        </div>
                    </div>
                    <span asp-validation-for="Input.NwpSupplierOid" class="field-error"></span>
                    @if (!string.IsNullOrEmpty(d.DetectedSupplier))
                    {
                        <small class="muted">Observed on document: <strong>@d.DetectedSupplier</strong>. This is not an approved master match until you select a live supplier above.</small>
                    }
                    else if (!string.IsNullOrEmpty(d.SupplierMasterName) && string.IsNullOrEmpty(d.NwpSupplierOid))
                    {
                        <small class="muted">Previously recorded text: <strong>@d.SupplierMasterName</strong>. Select a live supplier to approve its identity.</small>
                    }
                </div>

                <label>
                    <span>Observed supplier name</span>
                    <input asp-for="Input.ObservedSupplierName" />
                    <small class="muted">Captured from the invoice. This remains separate from the authoritative NWP supplier selected above.</small>
                </label>

                <label>
                    <span>Document type</span>
                    <select asp-for="Input.DocumentType" asp-items="Html.GetEnumSelectList<DocumentType>()"></select>
                </label>

                <div class="form-grid-2">
                    <label>
                        <span>Invoice number</span>
                        <input asp-for="Input.InvoiceNumber" />
                    </label>
                    <label>
                        <span>Invoice date</span>
                        <input asp-for="Input.InvoiceDate" type="date" />
                    </label>
                </div>

                <label>
                    <span>Batch / reference</span>
                    <input asp-for="Input.BatchOrReference" />
                </label>

                <div class="form-grid-2">
                    <label>
                        <span>Total</span>
                        <input asp-for="Input.Total" type="number" step="0.01" />
                    </label>
                    <label>
                        <span>Currency</span>
                        <input asp-for="Input.Currency" />
                    </label>
                </div>

                @if (d.Extraction is not null)
                {
                    <fieldset class="teach-fieldset">
                        <legend>Extracted line items</legend>
                        @for (var i = 0; i < Model.Input.Lines.Count; i++)
                        {
                            <div class="extraction-line-editor">
                                <strong>Line @(i + 1)</strong>
                                <div class="form-grid-2">
                                    <label><span>SKU</span><input asp-for="Input.Lines[i].Sku" /></label>
                                    <label><span>Description</span><input asp-for="Input.Lines[i].Description" /><span asp-validation-for="Input.Lines[i].Description" class="field-error"></span></label>
                                    <label><span>Quantity</span><input asp-for="Input.Lines[i].Quantity" type="number" step="0.0001" /></label>
                                    <label><span>Unit price</span><input asp-for="Input.Lines[i].UnitPrice" type="number" step="0.0001" /></label>
                                    <label><span>Line total</span><input asp-for="Input.Lines[i].LineTotal" type="number" step="0.0001" /></label>
                                </div>
                            </div>
                        }
                        @if (Model.Input.Lines.Count == 0) { <p class="muted">No line items were extracted.</p> }
                    </fieldset>
                }

                <div class="form-grid-2">
                    <label>
                        <span>Move to queue</span>
                        <select asp-for="Input.AssignedQueue">
                            <option>Invoice Queue</option>
                            <option>Statements</option>
                            <option>Other owner</option>
                            <option>Ignored</option>
                        </select>
                    </label>
                    <label>
                        <span>Workflow owner</span>
                        <input asp-for="Input.WorkflowOwner" placeholder="Maeve — standard queue" />
                    </label>
                </div>

                <fieldset class="teach-fieldset">
                    <legend>Teach the system for future invoices</legend>
                    <label class="checkbox-row"><input asp-for="Input.TeachSupplierAlias" /> <span>Save detected name as a supplier alias</span></label>
                    <label class="checkbox-row"><input asp-for="Input.TeachNestedEmailRule" /> <span>This supplier sends invoice PDFs inside attached .eml files</span></label>
                    <label class="checkbox-row"><input asp-for="Input.TeachMailboxRoute" /> <span>Remember this mailbox/routing rule for this supplier</span></label>
                    <label class="checkbox-row"><input asp-for="Input.TeachExtractionPattern" /> <span>Save this extraction pattern/template for this supplier</span></label>
                </fieldset>

                <label>
                    <span>Resolution note</span>
                    <textarea asp-for="Input.ResolutionNote" rows="3"></textarea>
                </label>

                <div class="resolution-actions">
                    <button type="submit" name="action" value="approve">Approve corrections</button>
                    <button type="submit" name="action" value="save" class="secondary-link-button">Save for further review</button>
                    <a class="secondary-link-button" asp-page="/Documents/Detail" asp-route-id="@d.Id">Back to document</a>
                </div>
            </form>
        </section>
    </div>

    <script>
        document.getElementById('exception-preview-dialog')?.addEventListener('click', function (event) {
            if (event.target === this) this.close();
        });
        (() => {
            const search = document.getElementById('Input_SupplierSearchLabel');
            const oid = document.getElementById('Input_NwpSupplierOid');
            const results = document.getElementById('supplier-master-results');
            const options = [...results.querySelectorAll('.supplier-master-option')];

            const filter = () => {
                const query = search.value.trim().toLowerCase();
                oid.value = '';
                let shown = 0;
                for (const option of options) {
                    const matches = query.length >= 2 && option.dataset.value.toLowerCase().includes(query) && shown < 25;
                    option.hidden = !matches;
                    if (matches) shown++;
                }
                results.hidden = shown === 0;
            };

            search?.addEventListener('input', filter);
            search?.addEventListener('focus', filter);
            const selectOption = option => {
                search.value = option.dataset.value;
                oid.value = option.dataset.oid;
                results.hidden = true;
            };
            results?.addEventListener('click', event => {
                const option = event.target.closest('.supplier-master-option[data-oid]');
                if (option) selectOption(option);
            });
            results?.addEventListener('keydown', event => {
                if (event.key !== 'Enter' && event.key !== ' ') return;
                const option = event.target.closest('.supplier-master-option[data-oid]');
                if (!option) return;
                event.preventDefault();
                selectOption(option);
            });
            document.addEventListener('click', event => {
                if (!event.target.closest('.supplier-master-picker')) results.hidden = true;
            });
        })();
    </script>
}
